{
  "$schema": "https://wails.io/schemas/config.v3.json",
  "name": "UniTunnel",
  "description": "UniTunnel - Acceso Universitario para Windows (Wails v3)",
  "version": "2.4.0",
  "author": {
    "name": "UniTunnel Dev",
    "email": "dev@unitunnel.uci"
  },
  "frontend": {
    "dir": "unitunnel-go/dist",
    "devUrl": "http://localhost:3000"
  },
  "backend": {
    "dir": "unitunnel-go"
  },
  "build": {
    "outputFilename": "unitunnel.exe",
    "clean": true
  },
  "windows": {
    "certificate": "",
    "digestAlgorithm": "SHA256",
    "timestampServer": "",
    "uac": {
      "level": "requireAdministrator"
    }
  },
  "android": {
    "packageName": "cu.uci.unitunnel",
    "applicationName": "UniTunnel",
    "versionCode": 240,
    "versionName": "2.4.0",
    "minSdkVersion": 26,
    "targetSdkVersion": 35,
    "permissions": [
      "android.permission.INTERNET",
      "android.permission.FOREGROUND_SERVICE",
      "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
      "android.permission.BIND_VPN_SERVICE",
      "android.permission.ACCESS_NETWORK_STATE"
    ]
  }
}
