# ==============================================================================
# UniTunnel - Pure Go Project .gitignore
# ==============================================================================

# Web companion dependencies
node_modules/

# Frontend build output (embedded by unitunnel-go/main.go via //go:embed all:dist)
# Only the placeholder is tracked so a clean clone can still run `go build`.
/unitunnel-go/dist/*
!/unitunnel-go/dist/.gitkeep

# Release output (local build_windows.bat + CI)
/dist/
/dist-release/

# Go build artifacts and binaries
bin/
*.exe
*.dll
unitunnel
unitunnel.exe
wintun.dll

# Explicitly track Windows PE resources and icons
!*.syso
!*.rc
!*.manifest
!*.ico

# Personal configuration & local credentials (use config.example.json instead)
unitunnel-go/config.json

# OS files
.DS_Store
Thumbs.db

# Editor / IDE state
.idea/
.vscode/
*.swp
ProxyAgent-UCI/